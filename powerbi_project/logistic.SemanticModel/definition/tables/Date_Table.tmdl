	column YearMonth
		lineageTag: a0bab1a1-2134-472a-85d1-16c1bc5d33ab
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonth]

		annotation SummarizationSetBy = Automatic

	partition Date_Table = calculated
		mode: import
		source = ```
				
				VAR MinDate = 
				    MINX(
				        {
				            MIN(loads[load_date]),
				            MIN(trips[dispatch_date]),
				            MIN(maintenance_records[maintenance_date]),
				            MIN(safety_incidents[incident_date]),
				            MIN(fuel_purchases[purchase_date])
				        },
				        [Value]
				    )
				
				VAR MaxDate = 
				    MAXX(
				        {
				            MAX(loads[load_date]),
				            MAX(trips[dispatch_date]),
				            MAX(maintenance_records[maintenance_date]),
				            MAX(safety_incidents[incident_date]),
				            MAX(fuel_purchases[purchase_date])
				        },
				        [Value]
				    )
				
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "MonthNumber", MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "YearMonth", FORMAT([Date], "YYYY-MM")
				)
				```

	annotation PBI_Id = a4e7e5ca694840b7a07e32713ca6e867

