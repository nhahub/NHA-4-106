		isNameInferred
		sourceColumn: [Hourly Bucket]
		sortByColumn: AM_PM

		annotation SummarizationSetBy = Automatic

	partition Time_Table = calculated
		mode: import
		source = ```
				
				VAR MinutesInDay = GENERATESERIES(0, 1439) -- توليد 1440 دقيقة (24 ساعة)
				RETURN
				ADDCOLUMNS(
				    MinutesInDay,
				    "Time", TIME(TRUNC([Value] / 60), MOD([Value], 60), 0),
				    "Hour", TRUNC([Value] / 60),
				    "Minute", MOD([Value], 60),
				    "AM_PM", IF(TRUNC([Value] / 60) < 12, "AM", "PM"),
				    "Hour 12", IF(TRUNC([Value] / 60) = 0 || TRUNC([Value] / 60) = 12, 12, MOD(TRUNC([Value] / 60), 12)),
				    "Hourly Bucket", 
				        VAR H = TRUNC([Value] / 60)
				        RETURN FORMAT(TIME(H, 0, 0), "hh tt") & " - " & FORMAT(TIME(IF(H = 23, 0, H + 1), 0, 0), "hh tt")
				)
				```

	annotation PBI_Id = 4c2e2aab931d45aa89483680f7d93381

